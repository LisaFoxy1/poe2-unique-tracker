{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PoE 2 Unique Tracker",
  "version": "0.1.1",
  "identifier": "com.poe2collector.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PoE 2 Unique Tracker",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/LisaFoxy1/poe2-unique-tracker/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGQjY3MDNFQjkwMkEyNApSV1FrS3BEckEyZjdEM0JYUzJvYjErOE83ZHlYVFdhU3cwTkowYnJ3Wm93UmxUd2VZQ1R0eUorSwo=",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
