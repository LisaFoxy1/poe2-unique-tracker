{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PoE Unique Tracker",
  "version": "0.1.2",
  "identifier": "com.poecollector.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PoE Unique Tracker",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/LisaFoxy1/poe-unique-tracker/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2QkYzNDc4NzJFMzU2RDUKUldUVlZ1TnllRFMvbHRHQ0NheUFnVzlnckF1NndSRE85VDlWZGxVRDFPWVJZR0NPWlZZV3UxMmMK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
